{
  "version": 1,
  "sdk_version": "3.0.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://tkksskpvpartlhpnctzu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "equus",
      "version": "0.1.0",
      "title": "Equus"
    },
    "tools": [
      {
        "name": "schedule_for_date",
        "title": "Schedule for a date",
        "description": "List the Equus riding school lesson times and how many riders are booked on a given date (YYYY-MM-DD).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date in YYYY-MM-DD format."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "my_bookings",
        "title": "My lessons",
        "description": "List the signed-in rider's riding lessons. Defaults to upcoming lessons; set scope to 'past' or 'all'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "all"
              ],
              "description": "Which lessons to return."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum number of lessons (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "my_subscriptions",
        "title": "My subscriptions",
        "description": "List the signed-in rider's Equus subscriptions (abonementai) with lessons used and remaining.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "my_profile",
        "title": "My profile",
        "description": "Get the signed-in rider's Equus profile (name, display name, phone, riding level).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
